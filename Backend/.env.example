# ─── Lensly backend environment ───────────────────────────────
# Copy to `.env` and fill in real values (never commit .env).

# Supabase — Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY   # server-only secret, bypasses RLS

# Auth (custom JWT)
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Server
PORT=3000
# Comma-separated allowed origins for CORS, or * in development.
# In production set this to your Cloudflare Pages domain.
CORS_ORIGIN=*

# ─── Real OTP delivery (see notify.js) ─────────────────────────
# Without these, /api/auth/otp/request returns a 503 — there is no
# fake/demo code fallback. Both are independent; email and WhatsApp
# each work once their own block below is filled in.

# Email — any SMTP provider (Gmail app password, SendGrid, Mailgun,
# Resend's SMTP relay, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password-or-app-password
SMTP_FROM="Lensly <no-reply@example.com>"

# WhatsApp — Twilio (https://www.twilio.com/whatsapp). The free sandbox
# number requires each recipient to send "join <sandbox-word>" to it
# once before they can receive messages — fine for testing, not for
# real users. Production needs an approved WhatsApp Business sender.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=+14155238886
